      "source": [
        "def classify_politeness(utterance): ##Politeness Classification Function\n",
        "\n",
        "    prompt = f\"\"\"\n",
        "You are a native Malay language speaker. Classify the politeness of the following Colloquial Malay utterance.\n",
        "\n",
        "Choose exactly ONE of these labels:\n",
        "\n",
        "Polite\n",
        "Impolite\n",
        "Neutral\n",
        "\n",
        "Definitions:\n",
        "Polite = the utterance clearly conveys politeness.\n",
        "Impolite = the utterance clearly conveys impoliteness.\n",
        "Neutral = the utterance does not clearly convey either politeness or impoliteness.\n",
        "\n",
        "Base your classification only on the linguistic material provided.\n",
        "Do not assume any additional conversational or social context.\n",
        "\n",
        "Utterance:\n",
        "{utterance}\n",
        "\n",
        "Return only one label:\n",
        "Polite\n",
        "Impolite\n",
        "Neutral\n",
        "\"\"\"\n",
        "\n",
        "    response = client.chat.completions.create(\n",
        "        model=MODEL,\n",
        "        messages=[\n",
        "            {\n",
        "                \"role\": \"system\",\n",
        "                \"content\": \"You classify the politeness of Colloquial Malay utterances.\"\n",
        "            },\n",
        "            {\n",
        "                \"role\": \"user\",\n",
        "                \"content\": prompt\n",
        "            }\n",
        "        ],\n",
        "        top_p=0.1,\n",
        "        temperature=0,\n",
        "        stream=False\n",
        "    )\n",
        "\n",
        "    answer = response.choices[0].message.content.strip()\n",
        "\n",
        "    return answer\n",
        "\n"
      ],
      "metadata": {
        "id": "gGT98jqsHrSU",
        "collapsed": true
      },
      "execution_count": 17,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def classify_politeness_cot(utterance):\n",
        "\n",
        "    prompt = f\"\"\"\n",
        "You are a Native Malay language speaker. Classify the politeness of the following Colloquial Malay utterance.\n",
        "\n",
        "Choose exactly ONE of these labels:\n",
        "\n",
        "Polite\n",
        "Impolite\n",
        "Neutral\n",
        "\n",
        "Definitions:\n",
        "Polite = the utterance clearly conveys politeness.\n",
        "Impolite = the utterance clearly conveys impoliteness.\n",
        "Neutral = the utterance does not clearly convey either politeness or impoliteness.\n",
        "\n",
        "Base your judgement only on the linguistic material provided.\n",
        "Do not assume any additional conversational or social context.\n",
        "\n",
        "Think through the problem step by step before deciding on your answer.\n",
        "\n",
        "Utterance:\n",
        "{utterance}\n",
        "\n",
        "After considering the problem, return only one label:\n",
        "Polite\n",
        "Impolite\n",
        "Neutral\n",
        "\"\"\"\n",
        "\n",
        "    response = client.chat.completions.create(\n",
        "        model=MODEL,\n",
        "        messages=[\n",
        "            {\n",
        "                \"role\": \"system\",\n",
        "                \"content\": \"You classify the politeness of Colloquial Malay utterances.\"\n",
        "            },\n",
        "            {\n",
        "                \"role\": \"user\",\n",
        "                \"content\": prompt\n",
        "            }\n",
        "        ],\n",
        "        top_p=0.1,\n",
        "        temperature=0,\n",
        "        stream=False\n",
        "    )\n",
        "\n",
        "    return response.choices[0].message.content.strip()"
      ],
      "metadata": {
        "id": "lWiD8FOrN9kF"
      },
      "execution_count": 23,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "results = []\n",
        "\n",
        "for index, row in task.iterrows():\n",
        "\n",
        "    triplet_id = row[\"Triplet_ID\"]\n",
        "\n",
        "    utterances = {\n",
        "        \"kan\": row[\"Kan_Text\"],\n",
        "        \"ke\": row[\"Ke_Text\"],\n",
        "        \"null\": row[\"Null_Text\"]\n",
        "    }\n",
        "\n",
        "    for particle, utterance in utterances.items():\n",
        "\n",
        "\n",
        "        if pd.isna(utterance):\n",
        "            continue\n",
        "\n",
        "        print(f\"Processing {triplet_id} - {particle}\")\n",
        "\n",
        "        try:\n",
        "            direct_rating = classify_politeness(str(utterance))\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"Error: {e}\")\n",
        "            direct_rating = \"ERROR\"\n",
        "\n",
        "        try:\n",
        "            cot_rating = classify_politeness_cot(utterance)\n",
        "        except Exception as e:\n",
        "            print(f\"CoT error: {e}\")\n",
        "            cot_rating = \"ERROR\"\n",
        "\n",
        "        results.append({\n",
        "            \"Triplet_ID\": triplet_id,\n",
        "            \"Particle\": particle,\n",
        "            \"Utterance\": utterance,\n",
        "            \"Direct_Rating\": direct_rating,\n",
        "            \"CoT_Rating\": cot_rating\n",
        "        })"
      ],
